//------------------------------ Trade Guards ------------------------//
bool PreTradeGuards()
{
   if(!EnableEA) return false;
   if(!InSession()) return false;
   if(!InICTSessions()) return false;
   if(InNewsPauseWindow()) return false;
   if(SpreadPoints()>MaxSpreadPoints) return false;
   if(CountPositionsSymbol(GSymbol)>=MaxPositionsPerSym) return false;
   if(CountPositionsAll()>=MaxPositionsTotal) return false;
   return true;
}

void TryOrder(const bool isBuy)
{
   double sl=0.0,tp=0.0;
   if(!ComputeSLTP(isBuy,sl,tp)){ Info("SL/TP calc failed"); return; }
   double lots=(UseFixedLot? FixedLotSize : CalcLotByRisk(sl));
   double lots=(UseFixedLot? FixedLotSize : CalcLotByRisk(isBuy,sl));
   double minlot=0.0,maxlot=0.0,step=0.0;
   SymbolInfoDouble(GSymbol,SYMBOL_VOLUME_MIN,minlot);
   SymbolInfoDouble(GSymbol,SYMBOL_VOLUME_MAX,maxlot);
   SymbolInfoDouble(GSymbol,SYMBOL_VOLUME_STEP,step);
   if(lots<minlot) lots=minlot;
   if(lots>maxlot) lots=maxlot;
   Trade.SetExpertMagicNumber(MagicNumber);
   Trade.SetDeviationInPoints(SlippagePoints);
   bool ok=false;
   if(isBuy) ok=Trade.Buy(lots,GSymbol,0.0,sl,tp,"PRO-Buy");
   else      ok=Trade.Sell(lots,GSymbol,0.0,sl,tp,"PRO-Sell");
   if(ok){ GOrders++; Info("Order placed"); } else { Info("Order failed"); }
}

void TryPartialClose(const string sym, const double pips, const double trig, const double pct){
   if(!EnablePartialClose) return;
   if(pips<trig) return;
   if(!PositionSelect(sym)) return;
   double vol=PositionGetDouble(POSITION_VOLUME);
   double minlot=0.0,maxlot=0.0,step=0.0;
   SymbolInfoDouble(sym,SYMBOL_VOLUME_MIN,minlot);
   SymbolInfoDouble(sym,SYMBOL_VOLUME_MAX,maxlot);
   SymbolInfoDouble(sym,SYMBOL_VOLUME_STEP,step);
   double closeVol=vol*(pct/100.0);
   if(step>0) closeVol=MathFloor(closeVol/step)*step;

   if(closeVol>=minlot && closeVol<vol){
      Trade.PositionClosePartial(sym,closeVol);
      Info("Partial close executed");
   }
}

//------------------------------ Position Management -----------------//
void ManageOpenPositions()
{
   int total = (int)PositionsTotal();
   int p     = total - 1;

   while (p >= 0)
   {
      if (PositionSelectByIndex(p))
      {
         if ((int)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
         {
            string sym = (string)PositionGetString(POSITION_SYMBOL);
            long   typ = (long)PositionGetInteger(POSITION_TYPE);
            double ep  = PositionGetDouble(POSITION_PRICE_OPEN);
            double sl  = PositionGetDouble(POSITION_SL);
            double tp  = PositionGetDouble(POSITION_TP);

            double pr  = (typ==POSITION_TYPE_BUY ? SymbolInfoDouble(sym,SYMBOL_BID)
                                                 : SymbolInfoDouble(sym,SYMBOL_ASK));
            double pips = (typ==POSITION_TYPE_BUY ? PriceToPips(pr-ep) : PriceToPips(ep-pr));

            // Break-even
            if (EnableBreakEven && pips >= BreakEvenTriggerPips)
            {
               double be = (typ==POSITION_TYPE_BUY
                            ? ep + PipsToPoints(BreakEvenOffsetPips)*_Point
                            : ep - PipsToPoints(BreakEvenOffsetPips)*_Point);
               int d = (int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
               be = NormalizeDouble(be,d);
               bool need = (typ==POSITION_TYPE_BUY ? (sl==0.0 || be>sl) : (sl==0.0 || be<sl));
               if (need) Trade.PositionModify(sym,be,tp);
            }

            // Trailing - Fixed
            if (DefaultTrailing==TRAIL_Fixed && pips >= TrailingStartPips)
            {
               double newSL = (typ==POSITION_TYPE_BUY
                               ? pr - PipsToPoints(TrailingDistancePips)*_Point
                               : pr + PipsToPoints(TrailingDistancePips)*_Point);
               int d2 = (int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
               newSL = NormalizeDouble(newSL,d2);
               bool need2 = (typ==POSITION_TYPE_BUY ? (sl==0.0 || newSL>sl) : (sl==0.0 || newSL<sl));
               if (need2) Trade.PositionModify(sym,newSL,tp);
            }
            // Trailing - ATR
            else if (DefaultTrailing==TRAIL_ATR)
            {
               double atrp = iATRpips(sym,PERIOD_M15,ATRPeriod);
               if (atrp > 0.0 && pips >= atrp*ATR_Trail_Mult)
               {
                  double newSL2 = (typ==POSITION_TYPE_BUY
                                   ? pr - PipsToPoints(atrp*ATR_Trail_Mult)*_Point
                                   : pr + PipsToPoints(atrp*ATR_Trail_Mult)*_Point);
                  int d3 = (int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
                  newSL2 = NormalizeDouble(newSL2,d3);
                  bool need3 = (typ==POSITION_TYPE_BUY ? (sl==0.0 || newSL2>sl) : (sl==0.0 || newSL2<sl));
                  if (need3) Trade.PositionModify(sym,newSL2,tp);
               }
            }

            // Partial close
            TryPartialClose(sym,pips,PC1_TriggerPips,PC1_ClosePct);
            TryPartialClose(sym,pips,PC2_TriggerPips,PC2_ClosePct);
            TryPartialClose(sym,pips,PC3_TriggerPips,PC3_ClosePct);
         }
      }
      p = p - 1;
   }
}

//------------------------------ Daily Stop --------------------------//
void CheckDailyStop()
{
   double dd = AccountDailyPnLPercent();
   if (MaxDailyLossPercent > 0.0 && dd <= -fabs(MaxDailyLossPercent))
   {
      int p = (int)PositionsTotal() - 1;
      while (p >= 0)
      {
         if (PositionSelectByIndex(p))
         {
            if ((int)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
            {
               string sym = (string)PositionGetString(POSITION_SYMBOL);
               Trade.PositionClose(sym);
            }
         }
         p = p - 1;
      }
      FlushStats();
      ExpertRemove();
   }
}
//------------------------------ Panel -------------------------------//
void DrawPanel()
{
   datetime now=TimeCurrent();
   if(now==GLastPanel) return;
   GLastPanel=now;
   string sess=(UseICTSessions? "ICT" : (UseSessionFilter? "Sess":"All"));
   string txt=StringFormat("Hybrid_Shot_Pro v5.0 | Spread:%d | Daily:%.2f%% | Sess:%s | Orders:%d W:%d L:%d MaxDD:%.2f%%",
      SpreadPoints(), AccountDailyPnLPercent(), sess, (int)GOrders, (int)GWins, (int)GLosses, GMaxDD);
   Comment(txt);
}

//------------------------------ Lifecycle ---------------------------//
int OnInit()
{
   if(!CheckLicense()) return INIT_FAILED;
   GSymbol=_Symbol;
   GDigits=(int)SymbolInfoInteger(GSymbol,SYMBOL_DIGITS);
   GPoint =_Point;
   GPip   =PipValue();
   MqlDateTime dt; TimeToStruct(TimeCurrent(),dt); dt.hour=0; dt.min=0; dt.sec=0; GDayStart=StructToTime(dt);
   GEquityAtDayStart=AccountInfoDouble(ACCOUNT_EQUITY);
   Trade.SetExpertMagicNumber(MagicNumber);
   Trade.SetDeviationInPoints(SlippagePoints);
   return INIT_SUCCEEDED;
}
void OnDeinit(const int reason){
   FlushStats();
   Comment("");
}
void OnTick()
{
   if(TimeCurrent()-GDayStart>=86400)
   {
      MqlDateTime dt; TimeToStruct(TimeCurrent(),dt); dt.hour=0; dt.min=0; dt.sec=0; GDayStart=StructToTime(dt);
      GEquityAtDayStart=AccountInfoDouble(ACCOUNT_EQUITY);
   }
   UpdateDrawdownStat();
   CheckDailyStop();
   ManageOpenPositions();
   if(PreTradeGuards())
   {
      bool b=false,s=false;
      if(GenerateSignals(b,s))
      {
         if(TradeDirection==DIR_BuyOnly) s=false;
         if(TradeDirection==DIR_SellOnly) b=false;
         if(b && !s) TryOrder(true);
         if(s && !b) TryOrder(false);
      }
   }
   DrawPanel();
}
void OnTradeTransaction(const MqlTradeTransaction& trans, const MqlTradeRequest& req, const MqlTradeResult& res){
   if(trans.type==TRADE_TRANSACTION_DEAL_ADD)
   {
      if(HistoryDealSelect(trans.deal))
      {
         long magic =HistoryDealGetInteger(trans.deal,DEAL_MAGIC);
         string sym =HistoryDealGetString (trans.deal,DEAL_SYMBOL);
         long entry =HistoryDealGetInteger(trans.deal,DEAL_ENTRY);
         double profit=HistoryDealGetDouble (trans.deal,DEAL_PROFIT);
         if(magic==MagicNumber && sym==GSymbol && entry==DEAL_ENTRY_OUT)
         {
            GGrossPnL+=profit;
            if(profit>=0.0) GWins++; else GLosses++;
         }
      }
   }
}
