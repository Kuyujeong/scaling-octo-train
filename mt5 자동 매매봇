void LogCSV(const string msg)
{
   if(!EnableCSVLogging) return;
   int h=FileOpen(CSVLogFile, FILE_READ|FILE_WRITE|FILE_CSV|FILE_SHARE_READ|FILE_SHARE_WRITE, ',');
   if(h==INVALID_HANDLE)
   {
      h=FileOpen(CSVLogFile, FILE_WRITE|FILE_CSV, ',');
      if(h==INVALID_HANDLE) return;
      FileWrite(h,"time","symbol","message");
   }
   FileSeek(h,0,SEEK_END);
   FileWrite(h, TimeToString(TimeCurrent(),TIME_DATE|TIME_MINUTES), GSymbol, msg);
   FileClose(h);
}
void Info(const string s){ Print(s); LogCSV(s); }

double AccountDailyPnLPercent()
{
   if(GEquityAtDayStart<=0.0) return 0.0;
   double cur=AccountInfoDouble(ACCOUNT_EQUITY);
   return ((cur-GEquityAtDayStart)/GEquityAtDayStart)*100.0;
}
void UpdateDrawdownStat()
{
   if(GEquityAtDayStart<=0.0) return;
   double cur=AccountInfoDouble(ACCOUNT_EQUITY);
   double dd=(GEquityAtDayStart-cur)/GEquityAtDayStart*100.0;
   if(dd>GMaxDD) GMaxDD=dd;
}
