//------------------------------ Sessions & News ---------------------//
bool InSession()
{
   if(!UseSessionFilter) return true;
   MqlDateTime dtNow; TimeToStruct(TimeCurrent(), dtNow);
   int h = (int)dtNow.hour;
   bool ok;
   if(SessionStartHour <= SessionEndHour)
      ok = (h >= SessionStartHour && h < SessionEndHour);
   else
      ok = (h >= SessionStartHour || h < SessionEndHour);
   if(!ok) Info("Session blocked");
   return ok;
}

bool InICTSessions()
{
   if(!UseICTSessions) return true;
   MqlDateTime dtNow; TimeToStruct(TimeCurrent(), dtNow);
   int h = (int)dtNow.hour;

   bool ldn;
   if(LondonStartHour <= LondonEndHour)
      ldn = (h >= LondonStartHour && h < LondonEndHour);
   else
      ldn = (h >= LondonStartHour || h < LondonEndHour);

   bool ny;
   if(NewYorkStartHour <= NewYorkEndHour)
      ny = (h >= NewYorkStartHour && h < NewYorkEndHour);
   else
      ny = (h >= NewYorkStartHour || h < NewYorkEndHour);

   bool ok = (ldn || ny);
   if(!ok) Info("ICT session blocked");
   return ok;
}

// CSV: YYYY-MM-DD,HH:MM,COUNTRY,EVENT,IMPACT
bool InNewsPauseWindow()
{
   if(!UseNewsPause) return false;
   int handle=FileOpen(NewsFile, FILE_READ|FILE_CSV, ',');
   if(handle==INVALID_HANDLE) return false;
   datetime now=TimeCurrent();
   bool paused=false;
   while(!FileIsEnding(handle))
   {
      string sDate=FileReadString(handle); if(FileIsEnding(handle)) break;
      string sTime=FileReadString(handle);
      string c=FileReadString(handle);
      string e=FileReadString(handle);
      string imp=FileReadString(handle);
      if(StringLen(sDate)>=10 && StringLen(sTime)>=4)
      {
         int y=(int)StringSubstr(sDate,0,4);
         int m=(int)StringSubstr(sDate,5,2);
         int d=(int)StringSubstr(sDate,8,2);
         int hh=(int)StringSubstr(sTime,0,2);
         int mm=(int)StringSubstr(sTime,3,2);
         MqlDateTime dt; TimeToStruct(now,dt);
         dt.year=y; dt.mon=m; dt.day=d; dt.hour=hh; dt.min=mm; dt.sec=0;
         datetime t=StructToTime(dt);
         datetime t0=t-NewsPauseBeforeMin*60;
         datetime t1=t+NewsPauseAfterMin*60;
         if(now>=t0 && now<=t1){ paused=true; break; }
      }
   }
   FileClose(handle);
   if(paused) Info("News pause");
   return paused;
}

//------------------------------ Market Series -----------------------//
int LoadSeries(const string sym, ENUM_TIMEFRAMES tf, int need,
               datetime &T[], double &O[], double &H[], double &L[], double &C[])
{
   int nT=CopyTime(sym,tf,0,need,T);
   int nO=CopyOpen(sym,tf,0,need,O);
   int nH=CopyHigh(sym,tf,0,need,H);
   int nL=CopyLow(sym,tf,0,need,L);
   int nC=CopyClose(sym,tf,0,need,C);
   if(nT<=0 || nO<=0 || nH<=0 || nL<=0 || nC<=0) return 0;
   ArraySetAsSeries(T,true);
   ArraySetAsSeries(O,true);
   ArraySetAsSeries(H,true);
   ArraySetAsSeries(L,true);
   ArraySetAsSeries(C,true);
   int n=nT;
   if(nO<n) n=nO;
   if(nH<n) n=nH;
   if(nL<n) n=nL;
   if(nC<n) n=nC;
   return n;
}

//------------------------------ Indicators/Signals ------------------//
bool SimpleSignals(bool &buy, bool &sell)
{
   buy=false; sell=false;
   int hRSI=iRSI(GSymbol,PERIOD_M15,RSIPeriod,PRICE_CLOSE);
   if(hRSI==INVALID_HANDLE) return false;
   double rsi[1]; bool okRSI=(CopyBuffer(hRSI,0,0,1,rsi)==1); IndicatorRelease(hRSI);

   int hF=iMA(GSymbol,PERIOD_M15,FastMAPeriod,0,MODE_EMA,PRICE_CLOSE);
   int hS=iMA(GSymbol,PERIOD_M15,SlowMAPeriod,0,MODE_EMA,PRICE_CLOSE);
   if(hF==INVALID_HANDLE || hS==INVALID_HANDLE){ if(hF!=INVALID_HANDLE) IndicatorRelease(hF); if(hS!=INVALID_HANDLE) IndicatorRelease(hS); return false; }
   double f[2], s[2];
   bool okF=(CopyBuffer(hF,0,0,2,f)==2);
   bool okS=(CopyBuffer(hS,0,0,2,s)==2);
   IndicatorRelease(hF); IndicatorRelease(hS);
   if(!(okRSI && okF && okS)) return false;

   bool crossUp=(f[0]>s[0] && f[1]<=s[1]);
   bool crossDn=(f[0]<s[0] && f[1]>=s[1]);
   if(crossUp && rsi[0]<=RSI_BuyLevel)  buy=true;
   if(crossDn && rsi[0]>=RSI_SellLevel) sell=true;
   return true;
}

bool IsSwingHigh(const double &H[], int idx, int len, const int total)
{
   if(idx-len<0 || idx+len>=total) return false;
   for(int k=1;k<=len;k++){ if(H[idx]<=H[idx+k] || H[idx]<=H[idx-k]) return false; }
   return true;
}
bool IsSwingLow(const double &L[], int idx, int len, const int total)
{
   if(idx-len<0 || idx+len>=total) return false;
   for(int k=1;k<=len;k++){ if(L[idx]>=L[idx+k] || L[idx]>=L[idx-k]) return false; }
   return true;
}

int DetectBOS(bool &bullBOS, bool &bearBOS)
{
   bullBOS=false; bearBOS=false;
   datetime T[]; double O[],H[],L[],C[];
   int n=LoadSeries(GSymbol, ICT_TF, 400, T,O,H,L,C);
   if(n<(2*ICT_SwingLen+10)) return -1;
   int sh=-1, sl=-1;
   for(int j=ICT_SwingLen; j<n-ICT_SwingLen; j++)
   {
      if(IsSwingHigh(H,j,ICT_SwingLen,n)) sh=j;
      if(IsSwingLow (L,j,ICT_SwingLen,n)) sl=j;
   }
   if(sh==-1 || sl==-1) return -2;
   if(C[0]>H[sh]) bullBOS=true;
   if(C[0]<L[sl]) bearBOS=true;
   return 0;
}

bool DetectSweep(bool forBuy)
{
   datetime T[]; double O[],H[],L[],C[];
   int n=LoadSeries(GSymbol, ICT_TF, 300, T,O,H,L,C);
   if(n<(2*ICT_SwingLen+10)) return false;
   int sw=-1;
   if(forBuy)
   {
      for(int j=ICT_SwingLen;j<n-ICT_SwingLen;j++){ if(IsSwingLow(L,j,ICT_SwingLen,n)) sw=j; }
      if(sw==-1) return false;
      if(L[0]<L[sw] && C[0]>=L[sw]) return true;
   }else
   {
      for(int j=ICT_SwingLen;j<n-ICT_SwingLen;j++){ if(IsSwingHigh(H,j,ICT_SwingLen,n)) sw=j; }
      if(sw==-1) return false;
      if(H[0]>H[sw] && C[0]<=H[sw]) return true;
   }
   return false;
}

void AsiaRange(double &hi, double &lo)
{
   hi = -DBL_MAX; lo = DBL_MAX;
   datetime T[]; double O[],H[],L[],C[];
   int n = LoadSeries(GSymbol, ICT_TF, 400, T,O,H,L,C);
   if(n<=0) return;

   datetime now = TimeCurrent();
   MqlDateTime md; TimeToStruct(now, md);
   md.hour=0; md.min=0; md.sec=0;
   datetime dayStart = StructToTime(md);

   for(int j=0;j<n;j++)
   {
      datetime bar_time = T[j];
      if(bar_time < dayStart) break;
      MqlDateTime b; TimeToStruct(bar_time, b);
      int hr = (int)b.hour;
      if(hr>=2 && hr<9)
      {
         if(H[j]>hi) hi=H[j];
         if(L[j]<lo) lo=L[j];
      }
   }
}

bool ComputeOTE(bool forBuy, double &z1, double &z2)
{
   datetime T[]; double O[],H[],L[],C[];
   int n=LoadSeries(GSymbol, ICT_TF, 400, T,O,H,L,C);
   if(n<(2*ICT_SwingLen+10)) return false;
   int sh=-1, sl=-1;
   for(int j=ICT_SwingLen;j<n-ICT_SwingLen;j++)
   {
      if(IsSwingHigh(H,j,ICT_SwingLen,n)) sh=j;
      if(IsSwingLow (L,j,ICT_SwingLen,n)) sl=j;
   }
   if(sh==-1 || sl==-1) return false;
   double a=0.0,b=0.0,rng=0.0;
   if(forBuy)
   {
      if(sl>sh) return false;
      a=L[sl]; b=H[sh]; rng=b-a; z1=b-0.79*rng; z2=b-0.62*rng;
   }else
   {
      if(sh>sl) return false;
      a=H[sh]; b=L[sl]; rng=a-b; z1=b+0.62*rng; z2=b+0.79*rng;
   }
   return (z1<z2);
}

bool HasDirectionalFVG(bool forBuy)
{
   datetime T[]; double O[],H[],L[],C[];
   int n=LoadSeries(GSymbol, ICT_TF, 10, T,O,H,L,C);
   if(n<5) return false;
   if(forBuy) return (L[1] > H[2]);
   return (H[1] < L[2]);
}

bool ICTSignals(bool &buy, bool &sell)
{
   buy=false; sell=false;
   bool bull=false, bear=false;
   if(ICT_RequireBOS){ if(DetectBOS(bull,bear)<0) return false; } else { bull=true; bear=true; }
   bool sweepB = (!ICT_RequireSweep) ? true : DetectSweep(true);
   bool sweepS = (!ICT_RequireSweep) ? true : DetectSweep(false);
   double asHi=0.0, asLo=0.0; bool useRange=true;
   if(ICT_UseSessionRange){ AsiaRange(asHi,asLo); if(asHi==-DBL_MAX || asLo==DBL_MAX) useRange=false; }
   double z1B=0.0,z2B=0.0,z1S=0.0,z2S=0.0; bool okB=true, okS=true;
   if(ICT_UseOTE){ okB=ComputeOTE(true,z1B,z2B); okS=ComputeOTE(false,z1S,z2S); }
   bool fvgB = (!ICT_UseFVG) ? true : HasDirectionalFVG(true);
   bool fvgS = (!ICT_UseFVG) ? true : HasDirectionalFVG(false);
   double bid=SymbolInfoDouble(GSymbol,SYMBOL_BID);
   bool condBuy = bull && sweepB && fvgB;
   if(ICT_UseSessionRange && useRange) condBuy = condBuy && (bid>asLo);
   if(ICT_UseOTE && okB)               condBuy = condBuy && (bid>=z1B && bid<=z2B);
   bool condSell= bear && sweepS && fvgS;
   if(ICT_UseSessionRange && useRange) condSell= condSell && (bid<asHi);
   if(ICT_UseOTE && okS)               condSell= condSell && (bid>=z1S && bid<=z2S);
   buy=condBuy; sell=condSell; return true;
}

bool GenerateSignals(bool &buy, bool &sell)
{
   if(SignalMode==ENTRY_Simple) return SimpleSignals(buy,sell);
   return ICTSignals(buy,sell);
}

//------------------------------ Risk & Orders -----------------------//
double iATRpips(const string sym, ENUM_TIMEFRAMES tf, int per)
{
   int h=iATR(sym,tf,per);
   if(h==INVALID_HANDLE) return 0.0;
   double v[1]; int n=CopyBuffer(h,0,0,1,v); IndicatorRelease(h);
   if(n!=1) return 0.0; 
   return PriceToPips(v[0]);
}
bool ComputeSLTP(bool isBuy, double &sl, double &tp)
{
   double atrp=(UseATRStops? iATRpips(GSymbol,PERIOD_M15,ATRPeriod) : 0.0);
   double slp=(UseATRStops && atrp>0.0)? MathMax(atrp*ATR_SL_Mult,MinSL_Pips) : MathMax(MinSL_Pips,6.0);
   double tpp=(UseATRStops && atrp>0.0)? atrp*ATR_TP_Mult : slp*2.0;
   double pr=(isBuy? SymbolInfoDouble(GSymbol,SYMBOL_ASK) : SymbolInfoDouble(GSymbol,SYMBOL_BID));
   double slpC=(isBuy? pr - PipsToPoints(slp)*_Point : pr + PipsToPoints(slp)*_Point);
   double tppC=(isBuy? pr + PipsToPoints(tpp)*_Point : pr - PipsToPoints(tpp)*_Point);
   int d=(int)SymbolInfoInteger(GSymbol,SYMBOL_DIGITS);
   sl=NormalizeDouble(slpC,d); tp=NormalizeDouble(tppC,d); 
   return true;
}
double CalcLotByRisk(double sl_price)
double CalcLotByRisk(const bool isBuy, const double sl_price)
{
   if(UseFixedLot) return FixedLotSize;
   double equity=AccountInfoDouble(ACCOUNT_EQUITY);
   double ask=SymbolInfoDouble(GSymbol,SYMBOL_ASK);
   double dist=MathAbs(PriceToPips(ask-sl_price)); if(dist<=0.0) dist=MinSL_Pips;
   double entry=(isBuy? SymbolInfoDouble(GSymbol,SYMBOL_ASK) : SymbolInfoDouble(GSymbol,SYMBOL_BID));
   double dist=MathAbs(PriceToPips(entry-sl_price));
   if(dist<=0.0) dist=MinSL_Pips;
   double tickVal=SymbolInfoDouble(GSymbol,SYMBOL_TRADE_TICK_VALUE);
   double tickSz=SymbolInfoDouble(GSymbol,SYMBOL_TRADE_TICK_SIZE);
   double pipValPerLot=(tickSz>0? tickVal/tickSz : 0.0)*PipValue();
   double risk=equity*(MaxRiskPercent/100.0);
   double lots=(pipValPerLot>0? risk/(dist*pipValPerLot) : 0.0);
   double minlot=0.0,maxlot=0.0,step=0.0;
   SymbolInfoDouble(GSymbol,SYMBOL_VOLUME_MIN,minlot);
   SymbolInfoDouble(GSymbol,SYMBOL_VOLUME_MAX,maxlot);
   SymbolInfoDouble(GSymbol,SYMBOL_VOLUME_STEP,step);
   if(step>0) lots=MathFloor(lots/step)*step;
   if(lots<minlot) lots=minlot;
   if(lots>maxlot) lots=maxlot;
   return lots;
}

